# Copy this file to .env and replace the example secrets before using authentication.
NODE_ENV=development
PORT=4000

# MongoDB must run as a replica set for signup and password-change transactions.
# Remove ?replicaSet=rs0 only if your local MongoDB is standalone (transactions will not work).
MONGODB_URI=mongodb://127.0.0.1:27017/greenwood_school_backend?replicaSet=rs0

# Comma-separated browser origins allowed by CORS. Native mobile requests usually have no Origin.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Google Cloud Storage. Use a private bucket with uniform bucket-level access.
# Cloud Run uses its attached service account through Application Default Credentials.
GCS_BUCKET_NAME=your-private-school-files-bucket
# Optional: set GCS_PROJECT_ID only when automatic project detection is unsuitable.
GCS_SIGNED_URL_TTL_SECONDS=300

# Generate two independent secrets (at least 32 bytes) with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# These development-only examples are not secure and must be replaced before use.
JWT_SECRET=local-development-only-replace-with-a-random-secret
OTP_HMAC_SECRET=local-development-only-use-a-different-random-secret
